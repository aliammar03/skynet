# NON-secret config — committed plaintext, Arcane git layer. (silly has no secrets.)
NODE_ENV=production
FORCE_COLOR=1
SILLYTAVERN_HEARTBEATINTERVAL=30
# SillyTavern hard-refuses to run with NO gate (it crash-loops on whitelistMode=false with
# no basic-auth/user-accounts). Its native gate is a source-IP whitelist, so allow loopback +
# the internal app-client range (10.10.0.0/16) — which covers the apps Caddy (10.10.100.35)
# and its X-Forwarded-For clients (enableForwardedWhitelist is on). This env overrides
# config.yaml `whitelist`, so the gate is reproducible from git, not a hand-edited appdata file.
# SKY-003 Phase 3's Authentik forward_auth is the durable, per-user gate.
SILLYTAVERN_WHITELIST=["::1","127.0.0.1","10.10.0.0/16"]
