# NON-secret config — committed plaintext, Arcane git layer. Secrets live in .env.sops.
KARAKEEP_VERSION=release
NEXTAUTH_URL=https://karakeep.aliammar.net
DATA_DIR=/data
MEILI_ADDR=http://meilisearch:7700
BROWSER_WEB_URL=http://chrome:9222
BROWSER_CONNECT_ONDEMAND=false
DISABLE_SIGNUPS=false
DISABLE_PASSWORD_AUTH=false
RATE_LIMITING_ENABLED=true
DISABLE_NEW_RELEASE_CHECK=false
INFERENCE_TEXT_MODEL=gpt-5.6-terra
INFERENCE_IMAGE_MODEL=gpt-5.6-luna
INFERENCE_USE_MAX_COMPLETION_TOKENS=true
INFERENCE_OUTPUT_SCHEMA=structured
OPENAI_REASONING_EFFORT=low
OPENAI_SERVICE_TIER=default
INFERENCE_CONTEXT_LENGTH=16384
INFERENCE_MAX_OUTPUT_TOKENS=4096
INFERENCE_LANG=english
INFERENCE_NUM_WORKERS=2
INFERENCE_JOB_TIMEOUT_SEC=180
INFERENCE_ENABLE_AUTO_TAGGING=true
INFERENCE_ENABLE_AUTO_SUMMARIZATION=true
EMBEDDING_TEXT_MODEL=text-embedding-3-small
OCR_USE_LLM=true
OCR_CACHE_DIR=/data/ocr-cache
OCR_LANGS=eng,urd
OCR_CONFIDENCE_THRESHOLD=45
CRAWLER_NUM_WORKERS=2
CRAWLER_DOWNLOAD_BANNER_IMAGE=true
CRAWLER_STORE_SCREENSHOT=true
CRAWLER_FULL_PAGE_SCREENSHOT=true
CRAWLER_STORE_PDF=true
CRAWLER_FULL_PAGE_ARCHIVE=true
CRAWLER_ENABLE_ADBLOCKER=true
CRAWLER_SCREENSHOT_TIMEOUT_SEC=30
CRAWLER_NAVIGATE_TIMEOUT_SEC=60
CRAWLER_PARSE_TIMEOUT_SEC=120
CRAWLER_JOB_TIMEOUT_SEC=300
CRAWLER_PARSER_MEM_LIMIT_MB=1024
CRAWLER_MONOLITH_TIMEOUT_SEC=60
CRAWLER_DOMAIN_RATE_LIMIT_WINDOW_MS=1000
CRAWLER_DOMAIN_RATE_LIMIT_MAX_REQUESTS=2
CRAWLER_VIDEO_DOWNLOAD=true
CRAWLER_VIDEO_DOWNLOAD_MAX_SIZE=1024
CRAWLER_VIDEO_DOWNLOAD_TIMEOUT_SEC=1800
MAX_ASSET_SIZE_MB=1024
DB_WAL_MODE=true
SEARCH_NUM_WORKERS=2
SEARCH_JOB_TIMEOUT_SEC=120
ASSET_PREPROCESSING_NUM_WORKERS=2
ASSET_PREPROCESSING_JOB_TIMEOUT_SEC=300
RULE_ENGINE_NUM_WORKERS=1
WEBHOOK_NUM_WORKERS=1
WEBHOOK_TIMEOUT_SEC=10
WEBHOOK_RETRY_TIMES=5
LOG_LEVEL=notice
EVENT_LOGS_ENABLED=false
OTEL_TRACING_ENABLED=false
