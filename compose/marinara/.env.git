# NON-secret config — committed plaintext, Arcane git layer. Secrets live in .env.sops.
PORT=7860
HOST=0.0.0.0
AUTO_OPEN_BROWSER=true
AUTO_UPDATE_ENABLED=true
AUTO_CREATE_DEFAULT_CONNECTION=true
DATA_DIR=/app/data
FILE_STORAGE_DIR=/app/data/storage
LOG_PRESET=default
LOG_LEVEL=warn
LOG_DISABLE_REQUEST_LOGGING=false
EMBEDDING_TIMEOUT_MS=300000
CHAT_GENERATION_TIMEOUT_MS=300000
MAX_TOOL_ROUNDS=100
CUSTOM_TOOL_TIMEOUT_MS=60000
IMAGE_GEN_TIMEOUT_MS=1800000
COMFYUI_GEN_TIMEOUT=2400
MARI_WIKI_CONTENT_MAX_BYTES=50000
MARI_WIKI_REQUEST_TIMEOUT_MS=30000
MARI_WIKI_CACHE_TTL_MS=300000
CORS_ORIGINS=*
IP_ALLOWLIST=
IP_ALLOWLIST_ENABLED=false
BASIC_AUTH_REALM=Marinara-Engine
ALLOW_UNAUTHENTICATED_PRIVATE_NETWORK=true
ALLOW_UNAUTHENTICATED_REMOTE=true
TRUSTED_HOSTS=marinara.aliammar.net
TRUSTED_PRIVATE_NETWORKS=10.0.0.0/8
BYPASS_AUTH_TAILSCALE=true
BYPASS_AUTH_DOCKER=true
REQUIRE_AUTH_FOR_DOCKER_PROXY=false
CSRF_TRUSTED_ORIGINS=https://marinara.aliammar.net
MARINARA_REQUIRE_ADMIN_SECRET_ON_LOOPBACK=false
UPDATES_APPLY_ENABLED=false
UPDATES_ALLOW_REMOTE_APPLY=false
SIDECAR_RUNTIME_INSTALL_ENABLED=false
CUSTOM_TOOL_SCRIPT_ENABLED=false
ENABLE_CUSTOM_AGENT_REPOS=false
PROVIDER_LOCAL_URLS_ENABLED=true
IMAGE_LOCAL_URLS_ENABLED=true
TTS_LOCAL_URLS_ENABLED=false
DEEPLX_LOCAL_URLS_ENABLED=false
WEBHOOK_LOCAL_URLS_ENABLED=false
VIDEO_REFERENCE_PUBLIC_BASE_URL=
SEEDANCE_VIDEO_POLL_INTERVAL_MS=10000
HAPTICS_ALLOW_REMOTE=false
INTIFACE_URL=ws://127.0.0.1:12345
IMPORT_ALLOWED_ROOTS=
BACKGROUNDREMOVER_AUTO_INSTALL=false
SPRITE_BACKGROUND_REMOVAL_ENGINE=auto
BACKGROUNDREMOVER_COMMAND=
BACKGROUNDREMOVER_PYTHON=
BACKGROUNDREMOVER_TIMEOUT_MS=600000
SPOTIFY_REDIRECT_URI=
NODE_ENV=production
MARINARA_DOCKER=true
