# librespeed — non-secret config, committed plaintext (Arcane's git layer). — compose.md
# Secrets NEVER go here. The stats-page PASSWORD + OBFUSCATION_SALT live only in .env.sops.
TZ=Asia/Karachi

# Serve the full test (frontend + backend) from this one container.
MODE=standalone
WEBPORT=8080
TITLE=Skynet Speed Test

# Persist every test to sqlite so slow-client history is reviewable at /results/stats.php
# (entrypoint hard-codes the sqlite file to /database/db.sql → the bind mount).
TELEMETRY=true
DB_TYPE=sqlite

# LAN diagnosis: keep client IPs so you can tell which device ran which test.
REDACT_IP_ADDRESSES=false

# Non-enumerable result IDs (the salt itself is in .env.sops).
ENABLE_ID_OBFUSCATION=true
