# NON-secret config — committed plaintext, the git env layer. Secrets live in .env.sops.
# Genuine Arcane runtime config captured from the live host. The GPU/runtime vars that were also
# present in the live arcane.env (NVIDIA_*/ROCR_*/HIP_*/ONEAPI_*/LD_LIBRARY_PATH) are image-baked
# defaults, not Arcane config — excluded here, review at relocation (SKY-019).
ENVIRONMENT=production
GIN_MODE=release
PORT=3552
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
