# aiostreams — non-secret config (committed, ingested by Arcane as .env.git)
# Secrets live in .env.sops (sops+age) and are injected at deploy via envsync.
BASE_URL=https://aiostreams.aliammar.net
SESSION_TTL_SECONDS=2592000
AIOSTREAMS_AUTH_REQUIRED=true
AIOSTREAMS_OIDC_ENABLED=true
AIOSTREAMS_OIDC_ISSUER=https://auth.aliammar.net/application/o/aiostreams/
AIOSTREAMS_OIDC_SCOPES=openid profile email groups
AIOSTREAMS_OIDC_USERNAME_CLAIM=preferred_username
AIOSTREAMS_OIDC_GROUPS_CLAIM=groups
AIOSTREAMS_OIDC_GROUP_PERMISSIONS=Homelab Admins=admin,Homelab Users=createConfig
AIOSTREAMS_OIDC_DEFAULT_PERMISSIONS=
AIOSTREAMS_OIDC_ALLOW_LOCAL_LOGIN=true
AIOSTREAMS_OIDC_AUTO_REDIRECT=false
AIOSTREAMS_OIDC_ALLOW_INSECURE_REQUESTS=false
