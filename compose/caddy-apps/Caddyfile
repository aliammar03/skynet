# Caddyfile — the apps front door (T2). The ENTIRE apps ingress, in one reviewable
# file. Add/change a route = edit here → PR → Ali merges → Arcane reconciles.
# See runbooks/publish-service.md and docs/design/identity-and-proxy.md.
{
	# ACME account contact (non-secret; lives in .env.git).
	email {env.ACME_EMAIL}

	# TLS via ACME DNS-01 using Cloudflare — proves domain control by writing a TXT
	# record on aliammar.net's PUBLIC authoritative DNS (Cloudflare). Needs no inbound
	# reachability, so it issues publicly-trusted certs for internal-only services with
	# zero device-trust install. The token (scoped Zone→DNS→Edit, aliammar.net only) is
	# the sole secret, injected from .env.sops via the environment.
	#
	# propagation_timeout -1 DISABLES certmagic's DNS self-check. That check queries the
	# authoritative NS directly on :53, which this apps Caddy (10.10.100.35) can't reach
	# (firewall rule 830 allows :53 egress only from HOST_PROXY_ADMIN + ROLE_DNS_RESOLVERS,
	# not HOST_PROXY_APPS) — so it timed out and blocked issuance for every NEW cert. The
	# public CA validates the TXT from the internet regardless, so the self-check is
	# skippable and the write stays purely on the Cloudflare API (:443). Existing certs are
	# cached in /data; without this, they'd fail identically on renewal.
	cert_issuer acme {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		propagation_timeout -1
	}

	# HTTP/1.1 + HTTP/2 only — no HTTP/3. Chromium/Electron clients (Obsidian LiveSync)
	# upgrade to h3 on the alt-svc hint, but QUIC/UDP-443 across the DMZ macvlan is
	# unreliable → the browser reports ERR_SSL_PROTOCOL_ERROR (and noisy LiveSync CORS/2xx
	# false-alarms). TCP h2 is plenty for these apps. (SKY-014 follow-up.)
	servers {
		protocols h1 h2
	}
}

# ===================================================================================
# OWN-AUTH services — they gate at their own login, so a plain reverse_proxy is enough.
# ===================================================================================

# karakeep — has its own login.
karakeep.aliammar.net {
	reverse_proxy 10.10.100.75:3000
}

# aiostreams — local login + OIDC (AUTH_REQUIRED=true).
aiostreams.aliammar.net {
	reverse_proxy 10.10.100.65:3000
}

# aiometadata — sign-in required + OIDC.
aiometadata.aliammar.net {
	reverse_proxy 10.10.100.66:3232
}

# marinara — HTTP basic auth (challenges 401 from the proxy).
marinara.aliammar.net {
	reverse_proxy 10.10.100.85:7860
}

# obsidian-livesync — CouchDB sync backend; gated by its own admin login (own-auth).
obsidian.aliammar.net {
	reverse_proxy 10.10.100.95:5984
}

# ===================================================================================
# NO-AUTH services — NO gate of their own; reachable only from app-client VLANs (rule
# 200), never the internet. SKY-003 P3 gated calibre with Authentik forward_auth (below);
# sillytavern is still proxied plain (network-segmentation-only) until it's converted too.
# ===================================================================================

# calibre — no native login. Gated by Authentik forward-auth (SKY-003 P3). Per-app
# proxy provider "calibre" (forward_single, external_host=https://calibre.aliammar.net)
# is bound to the embedded outpost, served by the Authentik server itself at
# 10.10.80.37:9000 (firewall rule 240). Authentik maps this vhost to that provider by
# the forwarded Host header. Unauthenticated → Authentik login; authenticated → calibre.
calibre.aliammar.net {
	# The outpost's own endpoints (/auth/caddy, /start, callbacks) come from Authentik.
	reverse_proxy /outpost.goauthentik.io/* 10.10.80.37:9000

	# Gate everything else: ask the outpost; bounce to Authentik if unauthenticated.
	forward_auth 10.10.80.37:9000 {
		uri /outpost.goauthentik.io/auth/caddy
		copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name X-Authentik-Uid
		trusted_proxies private_ranges
	}

	reverse_proxy 10.10.100.53:8080
}

# sillytavern — no login of its own; its IP-whitelist is disabled
# (SILLYTAVERN_WHITELISTMODE=false in compose/silly/.env.git) so the proxy can reach it.
sillytavern.aliammar.net {
	reverse_proxy 10.10.100.69:8000
}

# librespeed — LAN wifi speed test for clients (no native auth). Deliberately proxied plain
# and kept off the Cloudflare tunnel: a test must ride the internal path so it measures the
# wifi link, not the WAN. Stats page (/results/stats.php) is password-gated by the app itself.
speed.aliammar.net {
	reverse_proxy 10.10.100.72:8080
}

# ===================================================================================
# IDENTITY — Authentik's user-facing login/OIDC endpoint. auth.aliammar.net had no
# specific DNS record, so the *.aliammar.net wildcard sends it here; without this route
# it 404s and the OIDC logins above (issuer https://auth.aliammar.net/...) break.
# T2 apps-Caddy -> T3 Authentik web (10.10.80.37:9000) is the pre-authorized network
# path (firewall rule 240, PORT_AUTHENTIK). TLS terminates here; Caddy sets the
# X-Forwarded-* headers Authentik expects. This routes the login UI only — it grants no
# Authentik admin (that stays T3).
# ===================================================================================
auth.aliammar.net {
	# Published to the internet (SKY-014) so the calibre forward-auth redirect resolves for EXTERNAL
	# users. Keep the admin surface internal-only: refuse Authentik's admin UI when the request comes
	# in over the Cloudflare Tunnel — cloudflared connects to this proxy from 10.10.100.33, so a
	# remote_ip of .33 means "arrived via the public tunnel". Login/OIDC/flow endpoints stay public
	# (logins need them); /api/v3 is deliberately NOT blocked — the login flow executor lives under it.
	@tunnel_admin {
		remote_ip 10.10.100.33
		path /if/admin/*
	}
	respond @tunnel_admin 404

	reverse_proxy 10.10.80.37:9000
}
