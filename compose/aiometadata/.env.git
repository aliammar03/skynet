# NON-secret config — committed plaintext, Arcane git layer. Secrets live in .env.sops.
PORT=3232
HOST_NAME=https://aiometadata.aliammar.net
NODE_ENV=production
LOG_LEVEL=info
TZ=Asia/Karachi
CATALOG_TTL=86400
META_TTL=604800
META_CONCURRENCY=24
HEAP_LOG_INTERVAL_MIN=30
ENABLE_BUILTIN_POSTER_CACHE=true
POSTER_CACHE_DIR=/app/poster-cache
POSTER_CACHE_MAX_SIZE=25g
POSTER_CACHE_MEMORY_SIZE=512m
POSTER_CACHE_TTL_DAYS=0            # 0 = never expire; posters are immutable, PROVIDER_PRESETS keeps volatile art fresh
POSTER_CACHE_INACTIVE_DAYS=90     # primary eviction lever once TTL never fires
POSTER_PROXY_MAX_AGE_DAYS=7       # client/CDN Cache-Control (default 1) — repeat views skip the origin
POSTER_CACHE_BACKGROUNDS=true
POSTER_CACHE_LANDSCAPE_POSTERS=true
POSTER_CACHE_LOGOS=true
POSTER_CACHE_PROCESSED_IMAGES=true
POSTER_CACHE_FETCH_CONCURRENCY=32
POSTER_PROXY_ALLOW_PRIVATE=false
META_COLD_STORE_ENABLED=true
META_COLD_STORE_PATH=/app/cold-store/metacache.sqlite
META_COLD_STORE_MAX_BYTES=2gb
META_COLD_STORE_COMPRESSION=true
ENABLE_CACHE_WARMING=false
TMDB_POPULAR_WARMING_ENABLED=false
MAL_WARMUP_ENABLED=false
OIDC_ENABLED=true
OIDC_ISSUER=https://auth.aliammar.net/application/o/aiometadata/
OIDC_GROUPS_CLAIM=groups
OIDC_USERNAME_CLAIM=preferred_username
OIDC_GROUP_PERMISSIONS="Homelab Admins=admin,Homelab Users=createConfig"
OIDC_DEFAULT_PERMISSIONS=
OIDC_ALLOW_INSECURE_ISSUER=false
OIDC_RATE_LIMIT_PER_WINDOW=20
OIDC_RATE_LIMIT_WINDOW=300
AUTH_REQUIRE_SIGNIN=true
TRUST_PROXY_HOPS=1
SESSION_TTL_SECONDS=86400
JIKAN_API_BASE=http://jikan_rest:8080/v4
CACHE_COMPRESSION_ENABLED=true
CACHE_COMPRESSION_MIN_BYTES=2048
CONFIG_CACHE_COMPRESSION_ENABLED=true
ENABLE_SELF_HEALING=true
DISABLE_GUEST_MODE=true
LOG_BUFFER_MAX_ENTRIES=20000
LOG_BUFFER_MAX_BYTES=16777216
ANIME_API_OVERLAY_ENABLED=true
MAL_PAGE_SIZE=50
PREFER_SMALLER_POSTERS_TMDB=true
PREFER_SMALLER_LOGOS_TMDB=false      # full-res logos (one per title; low cost, crisper on TV)
PREFER_SMALLER_LANDSCAPE_TMDB=false  # full-res landscapes
PREFER_SMALLER_BACKDROPS_TMDB=false
POSTER_CACHE_THUMBNAILS=true
POSTER_CACHE_PROVIDER_PRESETS=true
POSTER_CACHE_INFER_TTL=false
IMAGE_WARM_QUEUE=true
IMAGE_WARM_QUEUE_MAX=20000
IMAGE_WARM_CONCURRENCY_MIN=4
IMAGE_WARM_CONCURRENCY_MAX=24
IMAGE_WARM_TARGET_LAG_MS=20
