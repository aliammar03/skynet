#!/usr/bin/env bash
# ops — the agent runner wrapper. Swapping engines changes ONE line: $OPS_ENGINE_CMD below.
# USAGE:
#   bin/ops nightly            # run the report-only nightly maintenance pass
#   bin/ops run "<prompt>"     # hand an ad-hoc task to the configured engine
#   bin/ops collect            # refresh inventory (all collectors), no agent
#   bin/ops entities           # L0 identity audit: derive every entity, flag running-unmapped holes
#   bin/ops query "<sql>"      # ad-hoc SQL over the rebuildable inventory.db join cache (SKY-018 P3)
# The engine is agent-agnostic by contract (AGENTS.md). Codex CLI is the default daily driver.
set -euo pipefail
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${REPO_DIR}"

# ── engine selection ──────────────────────────────────────────────────────────
# OPS_ENGINE          primary engine: codex|claude (default codex)
# OPS_ENGINE_FALLBACK secondary engine tried if the primary fails: codex|claude|none
#                     (default: the OTHER engine — so "prefer X, run Y as fallback" works OOTB;
#                      set to 'none' to disable and go straight to the deterministic script)
# OPS_ENGINE_CMD      full command override for the PRIMARY engine (custom flags)
# nightly tries: primary engine → fallback engine → scripts/nightly.sh (deterministic).
# Per-engine model is env-driven: OPS_CODEX_MODEL / OPS_CLAUDE_MODEL → each engine's --model
# flag (unset = the engine's own default).
engine_bin() { case "$1" in codex) echo codex;; claude) echo claude;; *) return 1;; esac; }
engine_cmd() { case "$1" in
  # --dangerously-bypass-approvals-and-sandbox = full autonomy, no codex-side sandbox — the VM
  # itself (least-priv user, no standing T3) is the boundary, and the nightly needs unrestricted
  # network for the T1 collectors, git push, and gh. codex's documented path for externally-
  # sandboxed hosts like this one. Replaces the removed --full-auto (codex ≥0.149).
  codex)  echo "codex exec --dangerously-bypass-approvals-and-sandbox${OPS_CODEX_MODEL:+ --model ${OPS_CODEX_MODEL}}";;
  claude) echo "claude -p --permission-mode acceptEdits${OPS_CLAUDE_MODEL:+ --model ${OPS_CLAUDE_MODEL}}";;
  *) return 1;; esac; }

OPS_ENGINE="${OPS_ENGINE:-codex}"
engine_bin "${OPS_ENGINE}" >/dev/null || { echo "unknown OPS_ENGINE '${OPS_ENGINE}' (use codex|claude)" >&2; exit 2; }
_other=codex; [ "${OPS_ENGINE}" = codex ] && _other=claude
OPS_ENGINE_FALLBACK="${OPS_ENGINE_FALLBACK:-${_other}}"
[ "${OPS_ENGINE_FALLBACK}" = none ] || engine_bin "${OPS_ENGINE_FALLBACK}" >/dev/null || {
  echo "unknown OPS_ENGINE_FALLBACK '${OPS_ENGINE_FALLBACK}' (use codex|claude|none)" >&2; exit 2; }
OPS_ENGINE_CMD="${OPS_ENGINE_CMD:-$(engine_cmd "${OPS_ENGINE}")}"
OPS_ENGINE_BIN="$(engine_bin "${OPS_ENGINE}")"
# ──────────────────────────────────────────────────────────────────────────────

collect_all() {
  echo "== refreshing inventory =="
  ./scripts/collect-proxmox.sh core    || true
  ./scripts/collect-proxmox.sh network || true
  ./scripts/collect-pbs.sh             || true
  ./scripts/collect-docker.sh docker-dmz || true
  ./scripts/collect-dns.sh             || true
  ./scripts/collect-firewall.sh        || true
  ./scripts/collect-opnsense.sh        || true
  ./scripts/collect-network-gear.sh    || true
  ./scripts/render-docs.sh             || true
}

cmd="${1:-nightly}"; shift || true
case "${cmd}" in
  collect) collect_all ;;
  entities) exec ./scripts/audit-entities.sh ;;
  query)
    sql="${1:?usage: bin/ops query \"<sql>\"}"
    SQLITE3="${SQLITE3:-sqlite3}"
    ${SQLITE3} --version >/dev/null 2>&1 || { echo "sqlite3 not installed — run nixos-rebuild (SKY-018 P3)" >&2; exit 3; }
    ./scripts/build-db.sh >/dev/null || exit $?    # rebuild the cache from inventory/ so answers are current
    exec ${SQLITE3} -header -column "${REPO_DIR}/.cache/inventory.db" "${sql}"
    ;;
  run)
    prompt="${1:?usage: bin/ops run \"<prompt>\"}"
    exec ${OPS_ENGINE_CMD} "${prompt}"
    ;;
  nightly)
    # Report-only until actions are promoted to the AGENTS.md auto-approve list.
    # Prefer the LLM engine; fall back to the deterministic script if it can't run.
    # Timestamped branch (date + HHMM) so manual re-runs in one day get their OWN branch instead
    # of colliding on inventory/<date> — computed ONCE here and handed to both the engine and the
    # gate so they agree on the exact name.
    export OPS_NIGHTLY_BRANCH="inventory/$(date +%Y-%m-%d-%H%M)"
    prompt="Run the nightly maintenance pass per runbooks/nightly.md. Report-only: refresh inventory (bin/ops collect), envsync, harvest the root-grant audit if a grant is active, then render docs (scripts/render-docs.sh) AND (re)write the human-readable narrative docs/generated/05-state-of-the-lab.md — a beautifully formatted, honest 'state of the lab' for HUMANS with agent commentary and what changed since last night (diff against main). Also run scripts/render-digest.sh to regenerate your own cold-boot page docs/generated/06-agent-digest.md (recent decisions / open threads / recent episodes, from ADRs + the journal + the roadmap) — that page is deterministic, so don't hand-write it. Likewise run scripts/render-context-map.sh to refresh docs/generated/07-context-map.md (what's loadable and what each artifact costs) — also deterministic. Also append a RAW episodic journal entry for tonight (bin/new journal session \"nightly \$(date +%F)\") per journal/README.md — concrete facts only (what ran, what changed vs main, any anomalies, and dead-ends in the Graveyard section); do NOT summarize at write time. Finally open a PR on branch ${OPS_NIGHTLY_BRANCH} (create it off the latest origin/main) with the summary. Take no T2 write or granted-root action unless it is on the AGENTS.md auto-approve list. Do NOT merge the PR yourself — leave it open; the deterministic gate (scripts/nightly-automerge.sh) decides the merge after you exit."
    if [ "${OPS_NIGHTLY_MODE:-agent}" = agent ]; then
      # ordered attempts: primary engine → fallback engine → deterministic script
      order=("${OPS_ENGINE}")
      [ "${OPS_ENGINE_FALLBACK}" != none ] && [ "${OPS_ENGINE_FALLBACK}" != "${OPS_ENGINE}" ] && order+=("${OPS_ENGINE_FALLBACK}")
      for e in "${order[@]}"; do
        b="$(engine_bin "${e}")"
        if ! command -v "${b}" >/dev/null 2>&1; then echo "engine '${e}' not installed — skipping" >&2; continue; fi
        if [ "${e}" = "${OPS_ENGINE}" ]; then c="${OPS_ENGINE_CMD}"; else c="$(engine_cmd "${e}")"; fi
        echo "== nightly via engine: ${e} (${c}) =="
        # The LLM opens the PR but never merges. Afterward run the SAME dumb merge-gate the
        # deterministic path uses (ADR 0004): generated-only + CI-green → squash-merge, else left
        # open. The safety is code, not the engine's judgement. Fails closed on any error.
        if ${c} "${prompt}"; then ./scripts/nightly-automerge.sh || true; exit 0; fi
        echo "engine '${e}' failed — trying next" >&2
      done
      echo "all engines exhausted — deterministic fallback" >&2
    else
      echo "OPS_NIGHTLY_MODE=script — deterministic nightly" >&2
    fi
    exec ./scripts/nightly.sh
    ;;
  *) echo "unknown command: ${cmd}" >&2; exit 2 ;;
esac
