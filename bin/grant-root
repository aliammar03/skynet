#!/usr/bin/env bash
# grant-root — WORKSTATION-ONLY. Signs an auto-expiring root cert for the ops agent (plan §8).
# This script is committed here so bootstrap-workstation.sh can install it to ~/bin/grant-root.
# It MUST run on Ali's workstation, where the CA private key lives. It must NEVER run on the VM —
# if the agent could sign its own cert, every trust tier in the plan would be decoration.
#
# USAGE: grant-root <hostname|all> [duration, default 2h]
#   grant-root vm-docker-dmz 1h   # root on one host for 1 hour
#   grant-root all 4h             # fleet-wide window for an update run
# The cert carries its own expiry; when it lapses, sshd simply refuses it. No cleanup.
#
# PER-HOST CERTS: the signed cert is placed at ~/.ssh/certs/<host>-cert.pub on skynet-ops (not
# the single ~/.ssh/id_ed25519-cert.pub). skynet-ops' ssh_config presents the right one per host
# (Match user root), so grants for different hosts NO LONGER clobber each other — issue several
# and they coexist until each expires on its own.
set -euo pipefail

HOST="${1:?host or 'all'}"; DUR="${2:-2h}"
CA_KEY="${HOME}/.skynet-ca/ops_ca"
VM="ali@10.10.90.90"

[ -f "${CA_KEY}" ] || { echo "CA not found at ${CA_KEY} — run bootstrap-workstation.sh first" >&2; exit 1; }

scp "${VM}:.ssh/id_ed25519.pub" /tmp/ops.pub
ssh-keygen -s "${CA_KEY}" \
  -I "grant+${HOST}+$(date -Iseconds)+by-ali" \
  -n "ops-root-${HOST}" \
  -V "+${DUR}" \
  /tmp/ops.pub
# Place the cert in the per-host slot (dir created 0700).
ssh "${VM}" 'mkdir -p ~/.ssh/certs && chmod 700 ~/.ssh ~/.ssh/certs'
scp /tmp/ops-cert.pub "${VM}:.ssh/certs/${HOST}-cert.pub"
rm -f /tmp/ops.pub /tmp/ops-cert.pub
# Refresh skynet-ops' ssh_config so `ssh root@${HOST}` presents this cert (coexists with others).
ssh "${VM}" 'test -x ~/skynet/scripts/skynet-ops-ssh-certs.sh && ~/skynet/scripts/skynet-ops-ssh-certs.sh' || \
  echo "note: run scripts/skynet-ops-ssh-certs.sh on skynet-ops once to wire ssh_config" >&2
echo "root on ${HOST} for ${DUR} — cert at ~/.ssh/certs/${HOST}-cert.pub, expires itself."
