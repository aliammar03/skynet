#!/usr/bin/env bash
# agent — launch a bounded construction helper by ROLE, or preview the resolution. → a codex process.
# TIER: T1 — build-time only. Helpers get NO production authority (no secrets/tokens/T2/T3); the
#   sandbox (writers=workspace-write, scout=read-only) is the boundary. Doctrine: docs/conventions/construction.md.
# USAGE:
#   bin/agent <lead|review|builder|mechanic|scout> "<prompt>" [--tier astra|terra|sol] [--cwd <dir>] [--dry-run]
#     --tier      lead only: use the execution tier named in the authorized phase packet
#     --cwd <dir> run the helper rooted at <dir> instead of the main checkout — for a git worktree,
#                 so two writers get separate filesystem state. Git is the isolation.
#     --dry-run   print the resolved role/tier/model/sandbox + exact command, launch nothing
#   Tier→model is env-overridable: AGENT_MODEL_{ASTRA,SOL,TERRA,LUNA}. No secrets are read.
#
# This is the STANDALONE mirror of the native in-session delegation in .codex/agents/*.toml. When a
# job fits native Codex subagents, prefer those (they enforce the ≤2-helper cap). One delegation
# level only — a helper launched here never launches its own helper.
set -euo pipefail

REPO_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

die() { echo "agent: $*" >&2; exit 1; }

role="${1:?usage: bin/agent <lead|review|builder|mechanic|scout> \"<prompt>\" [--tier astra|terra|sol] [--cwd <dir>] [--dry-run]}"
prompt="${2:?usage: bin/agent <role> \"<prompt>\" [--tier astra|terra|sol] [--cwd <dir>] [--dry-run]}"
shift 2 || true

requested_tier=""; dry=0; cwd=""
while [ $# -gt 0 ]; do case "$1" in
  --tier)    requested_tier="${2:?--tier needs astra|terra|sol}"; shift;;
  --dry-run) dry=1;;
  --cwd)     cwd="${2:?--cwd needs a directory}"; shift;;
  *) die "unknown flag '$1' (--tier astra|terra|sol | --cwd <dir> | --dry-run)";;
esac; shift; done

# Root the run at a registered worktree if --cwd was given, else the main checkout. Git is the only
# isolation: accepting an arbitrary directory would let a helper escape the repository contract.
workdir="${REPO_DIR}"
if [ -n "${cwd}" ]; then
  [ -d "${cwd}" ] || die "--cwd '${cwd}' is not a directory"
  workdir="$(cd -P "${cwd}" && pwd -P)"

  # A usable --cwd is precisely a root listed by this repository's worktree registry, with the
  # same common Git directory. The top-level check rejects a subdirectory; the common-dir check
  # rejects an unrelated repository; the registry check rejects an ordinary directory or a
  # lookalike Git checkout.
  repo_common_dir="$(git -C "${REPO_DIR}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
    || die "cannot determine this repository's Git common directory"
  repo_common_dir="$(cd -P "${repo_common_dir}" && pwd -P)" \
    || die "cannot resolve this repository's Git common directory"

  candidate_root="$(git -C "${workdir}" rev-parse --show-toplevel 2>/dev/null)" \
    || die "--cwd must be a registered Git worktree root for this repository"
  candidate_root="$(cd -P "${candidate_root}" && pwd -P)" \
    || die "--cwd must be a registered Git worktree root for this repository"
  [ "${candidate_root}" = "${workdir}" ] \
    || die "--cwd must be a registered Git worktree root for this repository"

  candidate_common_dir="$(git -C "${workdir}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
    || die "--cwd must be a registered Git worktree root for this repository"
  candidate_common_dir="$(cd -P "${candidate_common_dir}" && pwd -P)" \
    || die "--cwd must be a registered Git worktree root for this repository"
  [ "${candidate_common_dir}" = "${repo_common_dir}" ] \
    || die "--cwd must be a registered Git worktree root for this repository"

  registered=0
  while IFS= read -r registered_root; do
    registered_root="$(cd -P "${registered_root}" 2>/dev/null && pwd -P)" || continue
    if [ "${registered_root}" = "${workdir}" ]; then
      registered=1
      break
    fi
  done < <(git -C "${REPO_DIR}" worktree list --porcelain | sed -n 's/^worktree //p')
  [ "${registered}" = 1 ] \
    || die "--cwd must be a registered Git worktree root for this repository"
fi
cd "${workdir}"

# tier → concrete model. Env override is the only place model IDs live.
model_for_tier() { case "$1" in
  astra) echo "${AGENT_MODEL_ASTRA:-gpt-6-astra}";;
  sol)   echo "${AGENT_MODEL_SOL:-gpt-5.6-sol}";;
  terra) echo "${AGENT_MODEL_TERRA:-gpt-5.6-terra}";;
  luna)  echo "${AGENT_MODEL_LUNA:-gpt-5.6-luna}";;
  *) return 1;; esac; }

# role → tier / reasoning effort / sandbox / approval. The one routing table in code (doctrine:
# docs/conventions/construction.md). Scout is read-only by contract; writers stay workspace-scoped —
# deliberately MORE restricted than the nightly's full bypass, because construction touches no prod.
# Execution leads select the packet's tier; review uses the harness defaults unless overridden.
# Workers implement a bounded packet at Luna high or inspect at Luna medium.
case "${role}" in
  lead)
    tier="${requested_tier:-terra}"; sandbox=workspace-write
    case "${tier}" in
      astra) effort=medium;;
      terra) effort=high;;
      sol) effort=low;;
      *) die "lead tier must be astra|terra|sol";;
    esac;;
  review)   tier=selected; effort="${AGENT_REVIEW_EFFORT:-default}"; sandbox=workspace-write;;
  builder)  tier=luna;                        effort=high;   sandbox=workspace-write;;
  mechanic) tier=luna;                        effort=high;   sandbox=workspace-write;;
  scout)    tier=luna;                        effort=medium; sandbox=read-only;;
  *) die "unknown role '${role}' (lead|review|builder|mechanic|scout)";;
esac
[ -n "${requested_tier}" ] && [ "${role}" != lead ] && die "--tier is lead-only"

if [ "${role}" = review ]; then
  model="${AGENT_REVIEW_MODEL:-default}"
else
  model="$(model_for_tier "${tier}")"
fi

# codex exec: non-interactive helper, sandboxed, model + reasoning effort pinned to the role.
# The sandbox flag IS the leash — codex exec is already non-interactive, so there is no approval
# flag to set here (v0.149.0 `exec` has none; escalation beyond the sandbox is denied, not prompted).
# That is stricter than we need and exactly right for build-time helpers: a scout physically cannot
# write, a writer cannot leave the workspace. Do NOT reach for --dangerously-bypass-* or
# --approve-for-me — construction never earns access wider than its role's sandbox.
set -- codex exec --sandbox "${sandbox}" -C "${workdir}"
[ "${model}" = default ] || set -- "$@" --model "${model}"
[ "${effort}" = default ] || set -- "$@" -c "model_reasoning_effort=\"${effort}\""
set -- "$@" "${prompt}"

echo "role=${role}  tier=${tier}  model=${model}  effort=${effort}  sandbox=${sandbox}  cwd=${workdir}" >&2
if [ "${dry}" = 1 ]; then
  printf 'DRY-RUN — would launch:\n  ' >&2; printf '%q ' "$@" >&2; echo >&2
  exit 0
fi
command -v codex >/dev/null 2>&1 || die "codex not on PATH (install it, or use --dry-run to preview)"
exec "$@"
