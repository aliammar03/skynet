#!/usr/bin/env bash
# agent — launch one bounded construction worker by ROLE, or preview the resolution. → a codex process.
# TIER: T1 — build-time only. Workers get NO production authority (no secrets/tokens/T2/T3); the
#   sandbox (read-only | workspace-write) is the boundary. Doctrine: docs/conventions/construction.md.
# USAGE:
#   bin/agent <companion|investigator|default_executor|senior_executor|tester|archivist> "<prompt>" [--cwd <dir>] [--dry-run]
#     --cwd <dir> run the worker rooted at <dir> instead of the main checkout — for a git worktree,
#                 so two Executors get separate filesystem state. Git is the isolation.
#     --dry-run   print the resolved role/model/effort/sandbox + exact command, launch nothing
#
# This is the STANDALONE mirror of the native in-session delegation in .codex/agents/*.toml. When a
# job fits native Codex subagents, prefer those. A worker launched here never launches its own worker.
# Each role's model/effort/sandbox is READ FROM its .codex/agents/<role>.toml — the TOML is the single
# source of truth (source TOML wins over any README), so this launcher can never drift from it.
set -euo pipefail

REPO_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

USAGE='usage: bin/agent <companion|investigator|default_executor|senior_executor|tester|archivist> "<prompt>" [--cwd <dir>] [--dry-run]'
die() { echo "agent: $*" >&2; exit 1; }

role="${1:?${USAGE}}"
prompt="${2:?${USAGE}}"
shift 2 || true

dry=0; cwd=""
while [ $# -gt 0 ]; do case "$1" in
  --dry-run) dry=1;;
  --cwd)     cwd="${2:?--cwd needs a directory}"; shift;;
  *) die "unknown flag '$1' (--cwd <dir> | --dry-run)";;
esac; shift; done

# The role vocabulary is exactly the construction worker set — one .codex/agents/<role>.toml per role.
# No legacy scout/mechanic/builder aliases and no lead/review shim survive.
case "${role}" in
  companion|investigator|default_executor|senior_executor|tester|archivist) ;;
  *) die "unknown role '${role}' (companion|investigator|default_executor|senior_executor|tester|archivist)";;
esac

toml="${REPO_DIR}/.codex/agents/${role}.toml"
[ -r "${toml}" ] || die "missing role definition ${toml}"

toml_value() {
  # Extract a quoted top-level key from the role TOML: toml_value <key>
  sed -nE "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*\"([^\"]+)\".*/\1/p" "${toml}" | head -n 1
}
model="$(toml_value model)"
effort="$(toml_value model_reasoning_effort)"
sandbox="$(toml_value sandbox_mode)"
[ -n "${model}" ]   || die "${toml}: no model declared"
[ -n "${effort}" ]  || die "${toml}: no model_reasoning_effort declared"
[ -n "${sandbox}" ] || die "${toml}: no sandbox_mode declared"
# A construction worker never receives danger-full-access — the forbidden sandbox (invariants.json).
[ "${sandbox}" != "danger-full-access" ] || die "${toml}: sandbox danger-full-access is forbidden for construction workers"

# Root the run at a registered worktree if --cwd was given, else the main checkout. Git is the only
# isolation: accepting an arbitrary directory would let a worker escape the repository contract.
workdir="${REPO_DIR}"
if [ -n "${cwd}" ]; then
  [ -d "${cwd}" ] || die "--cwd '${cwd}' is not a directory"
  workdir="$(cd -P "${cwd}" && pwd -P)"

  # A usable --cwd is precisely a root listed by this repository's worktree registry, with the
  # same common Git directory. The top-level check rejects a subdirectory; the common-dir check
  # rejects an unrelated repository; the registry check rejects an ordinary directory or a
  # lookalike Git checkout.
  repo_common_dir="$(git -C "${REPO_DIR}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
    || die "cannot determine this repository's Git common directory"
  repo_common_dir="$(cd -P "${repo_common_dir}" && pwd -P)" \
    || die "cannot resolve this repository's Git common directory"

  candidate_root="$(git -C "${workdir}" rev-parse --show-toplevel 2>/dev/null)" \
    || die "--cwd must be a registered Git worktree root for this repository"
  candidate_root="$(cd -P "${candidate_root}" && pwd -P)" \
    || die "--cwd must be a registered Git worktree root for this repository"
  [ "${candidate_root}" = "${workdir}" ] \
    || die "--cwd must be a registered Git worktree root for this repository"

  candidate_common_dir="$(git -C "${workdir}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
    || die "--cwd must be a registered Git worktree root for this repository"
  candidate_common_dir="$(cd -P "${candidate_common_dir}" && pwd -P)" \
    || die "--cwd must be a registered Git worktree root for this repository"
  [ "${candidate_common_dir}" = "${repo_common_dir}" ] \
    || die "--cwd must be a registered Git worktree root for this repository"

  registered=0
  while IFS= read -r registered_root; do
    registered_root="$(cd -P "${registered_root}" 2>/dev/null && pwd -P)" || continue
    if [ "${registered_root}" = "${workdir}" ]; then
      registered=1
      break
    fi
  done < <(git -C "${REPO_DIR}" worktree list --porcelain | sed -n 's/^worktree //p')
  [ "${registered}" = 1 ] \
    || die "--cwd must be a registered Git worktree root for this repository"
fi
cd "${workdir}"

# codex exec: non-interactive worker, sandboxed, model + reasoning effort pinned from the role TOML.
# The sandbox flag IS the leash — codex exec is already non-interactive, so there is no approval flag
# to set (escalation beyond the sandbox is denied, not prompted). A read-only role physically cannot
# write; a write role cannot leave the workspace. Do NOT reach for --dangerously-bypass-* or
# --approve-for-me — construction never earns access wider than its role's sandbox.
set -- codex exec --sandbox "${sandbox}" -C "${workdir}" --model "${model}" \
  -c "model_reasoning_effort=\"${effort}\"" "${prompt}"

echo "role=${role}  model=${model}  effort=${effort}  sandbox=${sandbox}  cwd=${workdir}" >&2
if [ "${dry}" = 1 ]; then
  printf 'DRY-RUN — would launch:\n  ' >&2; printf '%q ' "$@" >&2; echo >&2
  exit 0
fi
command -v codex >/dev/null 2>&1 || die "codex not on PATH (install it, or use --dry-run to preview)"
exec "$@"
