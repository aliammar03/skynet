# Plaintext secrets — NEVER commit. Only *.sops / *.env.sops belong in git.
# NOTE: compose/*/.env.git IS committed — it is the NON-secret git layer Arcane
# ingests (README §4). Secrets never go there; the pre-commit scan enforces it.
.env
compose/*/.env
compose/*/project.env
*.key
*.pem
id_ed25519
id_ed25519-cert.pub
age.key

# Local agent scratch / runtime
/tmp/
*.tmp
*.log
.DS_Store
# The lead's disposable cross-session checkpoint (.agent/CHECKPOINT.md).
# Working memory is not repository truth; durable facts live in current docs or history-bearing files.
.agent/

# Collector working files (final JSON is committed by the collectors themselves)
inventory/**/*.partial.json
result
result-*

# The SQLite join cache is rebuilt from inventory/ at render time; git remains the source of truth.
.cache/

# Obsidian local session state and installed plugin payloads. Shared vault settings in .obsidian/
# stay tracked; plugins are installed locally from Community Plugins (docs/obsidian-setup.md).
.obsidian/workspace*.json
.obsidian/plugins/
