#!/usr/bin/env bash
# Repo pre-commit hook → the deterministic gates. Active when core.hooksPath=.githooks
# (bootstrap-workstation.sh sets this; or run once: git config core.hooksPath .githooks).
#   1. secret-scan       — no plaintext secrets enter a commit (AGENTS.md §6, staged tree).
#   2. check-invariants  — hard laws hold: excluded guests stay unpooled, the managed-pool dial
#                          matches inventory, and plaintext secrets are rejected.
#   3. entity-test       — VMID/IP derivation and entity-ID grammar hold against the known-good set.
#   4. digest-test       — resolved historical threads stay out of the cold-boot digest.
#   5. construction-test — construction limits and helper sandboxes match invariants.json.
#   6. agent-test        — bin/agent resolves every role to its declared tier/model/effort/sandbox.
#   7. gitignore-test    — the disposable .agent/ checkpoint directory stays ignored.
#   8. rollback/provisioning regressions — current executor, snapshot, certificate-selection, and
#      declared-guest truth stays covered locally as well as in CI.
# Bypass a false positive with:  git commit --no-verify  (CI re-runs every gate regardless).
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
"${ROOT}/scripts/secret-scan.sh"
"${ROOT}/scripts/check-invariants.sh"
bash "${ROOT}/tests/entity-test.sh"
bash "${ROOT}/tests/digest-test.sh"
bash "${ROOT}/tests/dns-revert-test.sh"
bash "${ROOT}/tests/compose-rollback-test.sh"
bash "${ROOT}/tests/cert-selector-test.sh"
bash "${ROOT}/tests/tofu-rollback-test.sh"
bash "${ROOT}/tests/pve-snapshot-test.sh"
bash "${ROOT}/tests/provisioning-truth-test.sh"
bash "${ROOT}/tests/collect-pbs-test.sh"
bash "${ROOT}/tests/construction-test.sh"
bash "${ROOT}/tests/agent-test.sh"
bash "${ROOT}/tests/gitignore-test.sh"
bash "${ROOT}/tests/obsidian-hygiene-test.sh"
bash "${ROOT}/tests/nightly-automerge-test.sh"
bash "${ROOT}/tests/nightly-sequence-test.sh"
bash "${ROOT}/tests/documentation-drift-test.sh"
bash "${ROOT}/tests/temporal-hygiene-test.sh"
bash "${ROOT}/tests/repo-surface-test.sh"
bash "${ROOT}/tests/hygiene-test.sh"
