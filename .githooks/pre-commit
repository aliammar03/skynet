#!/usr/bin/env bash
# Repo pre-commit hook → the deterministic gates. Active when core.hooksPath=.githooks
# (bootstrap-workstation.sh sets this; or run once: git config core.hooksPath .githooks).
#   1. secret-scan       — no plaintext secrets enter a commit (AGENTS.md §6, staged tree).
#   2. check-invariants  — the machine-checkable hard laws hold: excluded guests unpooled, the
#                          ops-managed pool set matches the declared dial, no plaintext secrets (SKY-011).
#   3. entity-test       — the L0 VMID->IP derivation + entity-ID grammar hold against the known-good
#                          set (SKY-018 P1). Unit test of scripts/entity.sh.
#   4. digest-test       — the cold-boot digest doesn't resurface open threads about DESTROYED guests
#                          (SKY-018 review — the append-only-journal feedback loop).
#   5. construction-test — the SKY-022 construction [testable] claims hold: the ≤2-helper cap and each
#                          helper's declared .codex/ sandbox match invariants.json (format-follows-enforcement).
# Bypass a false positive with:  git commit --no-verify  (CI re-runs every gate regardless).
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
"${ROOT}/scripts/secret-scan.sh"
"${ROOT}/scripts/check-invariants.sh"
bash "${ROOT}/tests/entity-test.sh"
bash "${ROOT}/tests/digest-test.sh"
bash "${ROOT}/tests/dns-revert-test.sh"
bash "${ROOT}/tests/compose-rollback-test.sh"
bash "${ROOT}/tests/tofu-rollback-test.sh"
bash "${ROOT}/tests/collect-pbs-test.sh"
bash "${ROOT}/tests/construction-test.sh"
bash "${ROOT}/tests/gitignore-test.sh"
