{
	servers {
		protocols h1 h2
		# Public requests arrive from cloudflared (10.10.100.33). Trust its header for the visitor's
		# address, so logs, the apps and their Authelia see the visitor, not the tunnel.
		trusted_proxies static 10.10.100.33/32
		client_ip_headers Cf-Connecting-Ip
	}
	# The healthcheck polls the admin API every 30 s; its request log is noise.
	log default {
		exclude admin.api
	}
}

# The apps' own Authelia (stacks/dmz/authelia), never the admin one. Of the visitor's cookies it gets
# only its session, which the site saved before dropping it.
(authelia) {
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
		header_up Cookie "authelia_apps_session={vars.apps_session}"
		copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
	}
}

# One wildcard cert, so no app name lands in certificate transparency logs.
*.aliammar.net {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		# Inside the lab Technitium answers for aliammar.net itself (dns/), so Caddy can't see the
		# challenge record: no propagation check, just a wait; Let's Encrypt checks Cloudflare.
		propagation_timeout -1
		propagation_delay 60s
	}
	# Sessions stay with their portals. Both Authelias' cookies are scoped to .aliammar.net, so
	# browsers send them to every app. Admin Authelia's is dropped everywhere; the apps' one everywhere
	# but its portal (login), after it is saved for the `authelia` snippet. No app ever sees a session
	# it could replay.
	vars apps_session {http.request.cookie.authelia_apps_session}
	@app not host login.aliammar.net
	request_header Cookie `(^|; *)authelia_session=[^;]*` ""
	request_header @app Cookie `(^|; *)authelia_apps_session=[^;]*` ""
	import /etc/caddy/sites/*.conf
	handle {
		respond 404
	}
}
