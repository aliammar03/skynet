# Example engine config for bin/ops / the nightly timer.
# Copy to /home/ali/.config/skynet-ops/ops.env on vm-skynet-ops (0600). No secrets belong here.
# The nightly unit reads it via EnvironmentFile=-; edits take effect on the next run (no reload).

# Primary + fallback engine. nightly tries: primary → fallback → deterministic scripts/nightly.sh
OPS_ENGINE=codex                 # codex | claude
# OPS_ENGINE_FALLBACK=claude      # codex | claude | none   (default: the OTHER engine)

# Model per engine (unset = engine default)
# OPS_CODEX_MODEL=gpt-5-codex
# OPS_CLAUDE_MODEL=claude-opus-4-8

# Other knobs
# OPS_NIGHTLY_MODE=script         # force deterministic path, skip LLMs entirely
# OPS_ENGINE_CMD='codex exec --full-auto --model X'   # full override of the PRIMARY command
