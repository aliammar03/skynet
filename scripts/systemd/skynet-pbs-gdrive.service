[Unit]
# Installed INSIDE the PBS host (lxc-proxmox-backup-server). Plan §6 L5.
# Off-site copy of the already-encrypted PBS datastore to Google Drive.
Description=skynet PBS datastore -> Google Drive off-site sync (L5)
Documentation=https://github.com/aliammar03/skynet/blob/main/runbooks/dr/DR-core-node.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/skynet-ops/scripts/backup-pbs-gdrive.sh
Nice=10
IOSchedulingClass=idle
# TimeoutStartSec was 6h — but the FIRST full seed of the ~39k-file chunk store to Google
# Drive takes longer than that (Drive throughput is bound by per-file API rate, not bandwidth).
# systemd was TERM-killing the job at the 6h mark every night, so it never got past chunk
# shard ~855f and ~46% of the datastore never uploaded (found in A6, 2026-08-16). Steady-state
# incrementals are tiny; only the initial seed is long. Give it room, still bounded well under
# the 24h re-trigger so a genuinely hung rclone can't run forever.
TimeoutStartSec=20h
